<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">
<log4j:configuration debug="false" xmlns:log4j='http://jakarta.apache.org/log4j/'>

    <!-- Existing Console Appender -->
    <appender name="console" class="org.apache.log4j.ConsoleAppender">
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="%d{yyyy-MM-dd HH:mm:ss}-%-5p - %m%n" />
        </layout>
    </appender>

    <!-- Existing Rolling File Appender -->
    <appender name="file" class="org.apache.log4j.RollingFileAppender">
        <param name="append" value="true" />
        <param name="maxFileSize" value="10MB" />
        <param name="maxBackupIndex" value="10" />
        <param name="file" value="Applogs/autologger3.log" />
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="%d{yyyy-MM-dd HH:mm:ss}-%-5p - %m%n" />
        </layout>
    </appender>

    <!-- New Message-Only Console Appender -->
    <appender name="messageOnlyConsole" class="org.apache.log4j.ConsoleAppender">
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="%m%n" />
        </layout>
    </appender>

    <!-- New Message-Only File Appender (same file as existing log) -->
    <appender name="messageOnlyFile" class="org.apache.log4j.FileAppender">
        <param name="append" value="true" />
        <param name="file" value="Applogs/autologger3.log" />
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="%m%n" />
        </layout>
    </appender>

    <!-- Dedicated Logger for size messages -->
    <logger name="NameAndSizeLogger" additivity="false">
        <level value="INFO" />
        <appender-ref ref="messageOnlyFile" />
        <appender-ref ref="messageOnlyConsole" />
    </logger>

    <!-- Root Logger (all other logs) -->
    <root>
        <level value="INFO" />
        <appender-ref ref="console" />
        <appender-ref ref="file" />
    </root>

</log4j:configuration>
